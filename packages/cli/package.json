{
  "name": "@aura-forge/cli",
  "version": "1.0.0",
  "description": "AURA Forge CLI — AI smart contract factory for your terminal",
  "type": "module",
  "main": "./dist/index.js",
  "bin": {
    "aura-forge": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "tsc",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest run"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "dependencies": {
    "@solana/web3.js": "^1.98.4",
    "bs58": "^6.0.0",
    "chalk": "^5.3.0",
    "commander": "^12.1.0",
    "ethers": "^6.17.0",
    "glob": "^11.0.0",
    "node-fetch": "^3.3.2",
    "ora": "^8.1.1"
  },
  "devDependencies": {
    "@types/bs58": "^5.0.0",
    "@types/node": "^22.0.0",
    "tsx": "^4.21.0",
    "typescript": "^5.6.0",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=18"
  }
}
